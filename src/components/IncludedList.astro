---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<h3>What's Included</h3>
<ul class="included-list">
  {items.map((item) => (
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      {item}
    </li>
  ))}
</ul>
