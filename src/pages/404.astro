---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Global Air Operations Group"
  description="The page you're looking for doesn't exist or may have moved. Return to the Global Air Operations Group homepage."
  canonical="https://www.globalairoperations.com/404"
>
  <main id="main">
    <section class="error-page">
      <div class="container">
        <p class="eyebrow">404</p>
        <h1>Page Not Found</h1>
        <p>The page you're looking for doesn't exist or may have moved. Let's get you back on course.</p>
        <div class="error-actions">
          <a class="btn btn-primary" href="/">Back to Homepage</a>
          <a class="btn btn-outline" href="/services">Browse Services</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
