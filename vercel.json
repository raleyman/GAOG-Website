{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/publications",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/publications/retardant-is-not-just-for-airtankers-anymore",
      "destination": "/insights/retardant-is-not-just-for-airtankers-anymore",
      "permanent": true
    },
    {
      "source": "/publications/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    }
  ]
}
